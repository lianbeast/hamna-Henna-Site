---
/**
 * Placeholder photo frame. When a real `src` is passed it renders an
 * <img>; otherwise it shows a labelled slot so the layout reads honestly
 * without shipping grey boxes.
 */
interface Props {
  src?: string;
  alt: string;
  label?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
}

const { src, alt, label, class: className = '', loading = 'lazy' } = Astro.props;
---

<div class:list={['photo-slot', className]}>
  {src ? (
    <img src={src} alt={alt} loading={loading} decoding="async" width="800" height="1000" />
  ) : (
    <div class="relative z-10 flex flex-col items-center gap-2 p-6 text-center" aria-hidden="true">
      <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" focusable="false">
        <rect x="3" y="3" width="18" height="18" rx="2" />
        <circle cx="8.5" cy="8.5" r="1.5" />
        <path d="M21 15l-5-5L5 21" />
      </svg>
      {label && <p class="text-xs tracking-widest uppercase">{label}</p>}
    </div>
  )}
  {/* real imagery carries the alt; an empty slot is decorative */}
  {!src && <span class="sr-only">{alt}</span>}
</div>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

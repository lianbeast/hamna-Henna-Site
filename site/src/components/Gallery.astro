---
import gallery from '../data/gallery.json';
import site from '../data/site.json';
---

<section id="gallery" class="section">
  <div class="shell">
    <header class="reveal mx-auto max-w-2xl text-center">
      <p class="eyebrow text-forest">Selected Work</p>
      <h2 class="mt-4 text-4xl text-espresso md:text-5xl">Gallery</h2>
      <p class="lede mx-auto mt-5 text-espresso">
        A sample of recent bridal and event work. Follow along for new designs each week.
      </p>
    </header>

    <ul class="mt-14 grid auto-rows-[190px] grid-cols-2 gap-4 md:auto-rows-[230px] md:grid-cols-4">
      {
        gallery.map((g) => (
          <li
            class:list={[
              'reveal photo-slot',
              g.span === 'tall' && 'row-span-2',
              g.span === 'wide' && 'col-span-2',
            ]}
          >
            {/* real image goes here via astro:assets <Image> when photos exist */}
            <span class="sr-only">{g.alt}</span>
            <span class="relative z-10 px-3 text-center text-[0.65rem] tracking-widest uppercase opacity-70">
              {g.placeholder}
            </span>
          </li>
        ))
      }
    </ul>

    <div class="mt-12 text-center">
      <a href={site.instagram} class="btn btn-ghost" rel="noopener me">
        View Full Gallery
      </a>
    </div>
  </div>
</section>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

---
import gallery from '../data/gallery.json';
import site from '../data/site.json';

type Entry = (typeof gallery)[number] & { src?: string };
const items = gallery as Entry[];
---

<section id="gallery" class="section">
  <div class="shell">
    <header class="reveal mx-auto max-w-2xl text-center">
      <p class="eyebrow text-terracotta">Selected Work</p>
      <h2 class="mt-4 type-display text-espresso md:text-5xl">Gallery</h2>
      <p class="lede mx-auto mt-5 text-espresso">
        A sample of recent bridal and event work. Follow along for new designs each week.
      </p>
    </header>

    <ul class="mt-14 grid auto-rows-[190px] grid-cols-2 gap-4 md:auto-rows-[230px] md:grid-cols-4">
      {
        items.map((g, i) => (
          <li
            class:list={[
              'reveal',
              g.span === 'tall' && 'row-span-2',
              g.span === 'wide' && 'col-span-2',
            ]}
          >
            <button
              type="button"
              class="photo-slot pf-open"
              data-index={i}
              data-alt={g.alt}
              data-placeholder={g.placeholder}
              data-src={g.src ?? ''}
              aria-label={`View enlarged: ${g.alt}`}
            >
              {g.src ? (
                <img src={g.src} alt="" aria-hidden="true" loading="lazy" decoding="async" />
              ) : (
                <>
                  <span class="sr-only">{g.alt}</span>
                  <span
                    aria-hidden="true"
                    class="relative z-10 px-3 text-center type-caption tracking-widest uppercase opacity-70"
                  >
                    {g.placeholder}
                  </span>
                </>
              )}
            </button>
          </li>
        ))
      }
    </ul>

    <div class="mt-12 text-center">
      <a href={site.instagram} class="btn btn-ghost" rel="noopener me">
        View Full Gallery
      </a>
    </div>
  </div>

  <dialog id="gallery-lightbox" class="lightbox" aria-labelledby="lightbox-caption">
    <div class="photo-slot lightbox-media" data-lightbox-media></div>
    <p id="lightbox-caption" class="lightbox-caption" data-lightbox-caption></p>
    <p class="lightbox-count" data-lightbox-count></p>
    <button type="button" class="btn btn-primary lightbox-close" data-close autofocus>Close</button>
  </dialog>
</section>

<script>
  const dialog = document.getElementById('gallery-lightbox');
  if (dialog instanceof HTMLDialogElement) {
    const media = dialog.querySelector('[data-lightbox-media]');
    const caption = dialog.querySelector('[data-lightbox-caption]');
    const count = dialog.querySelector('[data-lightbox-count]');
    const openers = Array.from(document.querySelectorAll('.pf-open'));

    const showItem = (index) => {
      const opener = openers[index];
      if (!(opener instanceof HTMLElement) || !media || !caption || !count) return;
      const alt = opener.dataset.alt ?? '';
      const placeholder = opener.dataset.placeholder ?? '';
      const src = opener.dataset.src ?? '';
      media.replaceChildren();
      if (src) {
        const img = document.createElement('img');
        img.src = src;
        img.alt = alt;
        img.decoding = 'async';
        media.appendChild(img);
      } else {
        const slot = document.createElement('span');
        slot.setAttribute('aria-hidden', 'true');
        slot.className = 'relative z-10 px-3 text-center type-caption tracking-widest uppercase opacity-70';
        slot.textContent = placeholder;
        media.appendChild(slot);
      }
      caption.textContent = alt;
      count.textContent = `${index + 1} of ${openers.length}`;
    };

    openers.forEach((opener, index) => {
      opener.addEventListener('click', () => {
        showItem(index);
        dialog.showModal();
      });
    });

    // backdrop click closes; Esc is native via the cancel event
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
  }
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .pf-open {
    width: 100%;
    height: 100%;
    min-height: 44px;
    cursor: zoom-in;
    font: inherit;
    padding: 0;
  }

  .pf-open:hover {
    border-color: var(--color-gold);
  }

  .lightbox {
    width: min(92vw, 52rem);
    padding: 1.25rem;
    background: var(--color-surface);
    color: var(--color-espresso);
    border: 1px solid color-mix(in srgb, var(--color-gold) 55%, transparent);
  }

  .lightbox::backdrop {
    background: color-mix(in srgb, var(--color-espresso) 55%, transparent);
  }

  .lightbox-media {
    aspect-ratio: 4 / 3;
    width: 100%;
    min-height: 16rem;
  }

  .lightbox-caption {
    margin: 1rem 0 0;
  }

  .lightbox-count {
    margin: 0.25rem 0 0;
    font-size: 0.8125rem;
    opacity: 0.75;
  }

  .lightbox-close {
    margin-top: 1rem;
    width: 100%;
  }

  @media (min-width: 640px) {
    .lightbox-close {
      width: auto;
    }
  }
</style>

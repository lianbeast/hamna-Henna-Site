---
// Static hero — no 3D, no canvas. Large heading, subtitle, single CTA.
---

<header class="hero-zone" id="hero">
  <div class="hero-content">
    <p class="hero-eyebrow label">Henna by Hamna · DMV</p>
    <h1 class="hero-title">Henna, drawn by hand</h1>
    <p class="hero-tagline">
      Simple, detailed, and Arabic designs for Eid, Chaand-Raat, weddings, and your once-in-a-lifetime moments.
   </p>
    <a href="#booking" class="hero-cta">Book a session</a>
    <div class="hero-links">
      <a href="tel:+13015554321">301.555.4321</a>
      <span class="hero-sep" aria-hidden="true">·</span>
      <a href="https://www.instagram.com/dmvflowerbar/" target="_blank" rel="noopener">@dmvflowerbar</a>
   </div>
 </div>
</header>

<style>
  .hero-zone {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: clamp(64px, 10vw, 120px) 24px clamp(48px, 8vw, 96px);
  }

  .hero-content {
    max-width: 720px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .hero-eyebrow {
    color: var(--color-gold);
    margin: 0;
    padding: 5px 16px;
    border: 1px solid var(--color-sandline);
    border-radius: 999px;
    background: rgba(251, 244, 231, 0.5);
  }

  .hero-title {
    font-size: clamp(40px, 8vw, 72px);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-inkbrown);
    margin: 0;
    text-wrap: balance;
  }

  .hero-tagline {
    font-size: clamp(16px, 2.4vw, 19px);
    color: var(--color-clay);
    line-height: 1.55;
    margin: 0;
    max-width: 52ch;
  }

  .hero-cta {
    margin-top: 10px;
    padding: 12px 28px;
    background: var(--color-henna);
    color: var(--color-paper);
    border-radius: 999px;
    text-decoration: none;
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0.04em;
    border: 1px solid var(--color-henna);
  }
  .hero-cta:hover {
    background: var(--color-rust);
    border-color: var(--color-rust);
  }
  .hero-cta:focus-visible {
    outline: 2px solid var(--color-rust);
    outline-offset: 2px;
  }

  .hero-links {
    margin-top: 18px;
    display: flex;
    gap: 8px;
    align-items: center;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-clay);
  }

  .hero-links a {
    color: var(--color-inkbrown);
    text-decoration: none;
    font-weight: 600;
    border-bottom: 1px solid var(--color-rust);
    padding-bottom: 1px;
  }
  .hero-links a:hover { color: var(--color-henna); }

  .hero-sep { color: var(--color-gold); }
</style>

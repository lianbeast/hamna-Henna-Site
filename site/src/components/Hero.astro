---
import CornerFloral from './ornaments/CornerFloral.astro';
import OrnateDivider from './ornaments/OrnateDivider.astro';
import MehndiMotif from './ornaments/MehndiMotif.astro';
import site from '../data/site.json';
---

<section id="top" class="hero">
  <CornerFloral class="botanical top-0 left-0 w-40 md:w-64" />
  <CornerFloral class="botanical right-0 bottom-0 w-40 rotate-180 md:w-64" />
  <MehndiMotif class="pointer-events-none absolute -top-2 right-6 w-40 text-beige opacity-40 md:right-16 md:w-56" />

  <div class="shell relative z-10 pt-16 pb-24 md:pt-24 md:pb-32">
    <div class="arch-panel arched has-text-over mx-auto max-w-4xl px-6 pt-20 pb-16 md:px-16 md:pt-28 md:pb-20">
      <div class="arch-rule pointer-events-none absolute inset-0" aria-hidden="true"></div>

      <div class="relative">
        <p class="eyebrow mb-6 text-forest">{site.availability}</p>

        <h1 class="hero-title">
          <span class="script block text-forest">Intricate Mehndi</span>
          <span class="block text-espresso">Timeless Beauty</span>
        </h1>

        <div class="my-9"><OrnateDivider /></div>

        <p class="lede mx-auto text-center text-espresso">{site.description}</p>

        <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a href="#gallery" class="btn btn-primary w-full sm:w-auto">Explore My Work</a>
          <a href="#contact" class="btn btn-ghost w-full sm:w-auto">Book a Consultation</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
  }

  .arch-panel {
    position: relative;
    background: var(--color-floral);
    border: 1px solid color-mix(in srgb, var(--color-gold) 45%, transparent);
    box-shadow: 0 20px 60px -30px color-mix(in srgb, var(--color-emerald) 40%, transparent);
  }

  :global(.theme-dark) .arch-panel {
    box-shadow: none;
  }

  .hero-title {
    font-size: clamp(2.75rem, 9vw, 5.5rem);
    line-height: 1.05;
    text-align: center;
  }
</style>

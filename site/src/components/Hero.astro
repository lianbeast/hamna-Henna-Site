---
import HennaSceneLoader from './HennaSceneLoader.tsx';
---

<header class="hero-zone" id="hero">
  <!-- 3D canvas background (lazy loaded, client-only) -->
  <div class="hero-canvas-wrap">
    <HennaSceneLoader client:only="react" />
  </div>

  <!-- Gradient fades at edges to blend canvas into page -->
  <div class="hero-gradient-top"></div>
  <div class="hero-gradient-bottom"></div>

  <!-- Overlaid content -->
  <div class="hero-content">
    <p class="hero-eyebrow label">Henna by Hamna</p>
    <h1 class="hero-title">The Craft Book</h1>
    <p class="hero-tagline">
      A mehndi artist's folio, opened to your day.
    </p>
    <p class="hero-desc">
      Every design starts as one clean line — nothing printed, nothing traced, the hand decides.
    </p>
    <div class="hero-links">
      <a href="tel:+13015554321">301.555.4321</a>
      <span class="hero-sep" aria-hidden="true">·</span>
      <a href="https://www.instagram.com/henna-designer/" target="_blank" rel="noopener">@henna-designer</a>
      <span class="hero-sep" aria-hidden="true">·</span>
      <span class="hero-year">Folio I · 2026</span>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="scroll-hint" aria-hidden="true">
    <span class="scroll-hint-line"></span>
    <span class="scroll-hint-text">Scroll</span>
  </div>
</header>

<style>
  .hero-zone {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin-bottom: 56px;
  }

  .hero-canvas-wrap {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-gradient-top {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 20vh;
    background: linear-gradient(to bottom, var(--color-ivory), transparent);
    z-index: 1;
    pointer-events: none;
    transition: background 0.45s ease;
  }

  .hero-gradient-bottom {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 30vh;
    background: linear-gradient(to top, var(--color-ivory) 30%, transparent);
    z-index: 1;
    pointer-events: none;
    transition: background 0.45s ease;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 680px;
    padding: 0 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .hero-eyebrow {
    color: var(--color-gold);
    margin: 0;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    background: rgba(251, 244, 231, 0.5);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    padding: 5px 18px;
    border-radius: 20px;
    border: 1px solid rgba(221, 201, 168, 0.35);
    transition: background-color 0.45s ease, border-color 0.45s ease, color 0.45s ease;
  }

  .hero-title {
    font-size: clamp(48px, 9vw, 88px);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--color-inkbrown);
    margin: 0;
    text-wrap: balance;
    filter: drop-shadow(0 2px 8px rgba(251, 244, 231, 0.7));
  }

  .hero-tagline {
    font-size: clamp(17px, 3vw, 22px);
    font-style: italic;
    color: var(--color-henna);
    margin: 0;
    filter: drop-shadow(0 1px 4px rgba(251, 244, 231, 0.7));
  }

  .hero-desc {
    font-size: 15px;
    color: var(--color-clay);
    max-width: 44ch;
    line-height: 1.6;
    margin: 0;
    opacity: 0.85;
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    align-items: center;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-clay);
    margin-top: 8px;
  }

  .hero-links a {
    color: var(--color-inkbrown);
    text-decoration: none;
    font-weight: 600;
    border-bottom: 1px solid var(--color-rust);
    padding-bottom: 1px;
    transition: color 0.2s;
  }

  .hero-links a:hover { color: var(--color-henna); }

  .hero-sep {
    color: var(--color-gold);
    font-weight: 400;
  }

  .hero-year {
    color: var(--color-clay);
    font-variant-numeric: tabular-nums;
  }

  /* Scroll hint */
  .scroll-hint {
    position: absolute;
    bottom: 32px;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    opacity: 0.7;
    animation: scrollPulse 2.5s ease-in-out infinite;
  }

  .scroll-hint-line {
    display: block;
    width: 1px;
    height: 40px;
    background: linear-gradient(to bottom, var(--color-henna), transparent);
  }

  .scroll-hint-text {
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-clay);
  }

  @keyframes scrollPulse {
    0%, 100% { opacity: 0.4; transform: translateY(0); }
    50% { opacity: 0.85; transform: translateY(6px); }
  }

  @media (max-width: 640px) {
    .hero-zone {
      min-height: 90vh;
    }
    .hero-title {
      font-size: clamp(38px, 12vw, 56px);
    }
  }
</style>
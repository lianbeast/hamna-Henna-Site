---

<header class="masthead" aria-label="Henna by Hamna — top of page">
  <div class="masthead-inner">
    <h1 class="brand-name">Henna by <span class="accent">Hamna</span></h1>
    <p class="brand-tag">The Craft Book</p>
  </div>
  <div class="folio-mark">
    <b>2026</b> Folio I
  </div>
</header>

<section class="hero" aria-label="Introduction">
  <div class="hero-copy">
    <h2 class="hero-headline">A mehndi artist's folio, opened to your day.</h2>
    <p class="hero-body">
      Every design starts as one clean line. Nothing printed, nothing traced — the hand decides.
    </p>
    <nav class="contact-row" aria-label="Contact">
      <a href="tel:+13015554321" class="phone-link">301.555.4321</a>
      <a href="https://www.instagram.com/henna-designer/" target="_blank" rel="noopener" class="ig-link">@henna-designer</a>
    </nav>
  </div>
  <div class="hero-stamp" aria-hidden="true">
    <svg class="hero-stamp-ring" viewBox="0 0 200 200" fill="none">
      <circle cx="100" cy="100" r="96" stroke="var(--plate-gold)" stroke-width="1" opacity="0.5" />
      <circle cx="100" cy="100" r="86" stroke="var(--plate-gold)" stroke-width="0.6" opacity="0.35" />
    </svg>
    <svg class="hero-stamp-cone" viewBox="0 0 40 40" fill="none">
      <path
        d="M20 4c-5 7-8 13-8 18a8 8 0 0016 0c0-5-3-11-8-18z"
        stroke="var(--plate-gold)"
        stroke-width="1.3"
        stroke-linejoin="round"
      />
      <path d="M12 22h16" stroke="var(--plate-gold)" stroke-width="1.3" stroke-linecap="round" />
      <path d="M20 30v6" stroke="var(--plate-gold)" stroke-width="1.3" stroke-linecap="round" />
      <circle cx="20" cy="37" r="1.4" fill="var(--plate-gold)" />
    </svg>
    <p class="hero-stamp-script">Hamna</p>
    <p class="hero-stamp-tag">Henna by hand</p>
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 32px;
    margin-bottom: 80px;
  }
  @media (min-width: 720px) {
    .hero {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
    .hero-copy { max-width: 46ch; }

  /* Circular stamp badge. Fixed dark plate, so it keeps one identity in
     both themes; plate-gold on plate-ink is 8.1:1, so the copy is AA+. */
  .hero-stamp {
    position: relative;
    flex: 0 0 auto;
    width: 168px;
    height: 168px;
    border-radius: 50%;
    background: var(--plate-ink);
    color: var(--plate-gold);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    text-align: center;
    padding: 22px;
    box-shadow: var(--shadow-card);
  }
  .hero-stamp-ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .hero-stamp-cone {
    position: relative;
    width: 30px;
    height: 30px;
    margin-bottom: 2px;
  }
  .hero-stamp-script {
    position: relative;
    font-family: var(--font-script);
    font-size: 34px;
    line-height: 1;
    margin: 0;
    color: var(--plate-gold);
  }
  .hero-stamp-tag {
    position: relative;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1.3;
    margin: 0;
    color: var(--plate-gold);
    opacity: 0.85;
  }
  @media (max-width: 600px) {
    .hero-stamp { width: 136px; height: 136px; padding: 18px; }
    .hero-stamp-script { font-size: 28px; }
  }
  }
  @media (max-width: 600px) {
    .hero { flex-direction: column-reverse; }
    .folio-mark { display: none; }
    .masthead { flex-direction: column; align-items: flex-start; }
  }
</style>
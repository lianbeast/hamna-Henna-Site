---
import CornerFloral from './ornaments/CornerFloral.astro';
import OrnateDivider from './ornaments/OrnateDivider.astro';
import MehndiMotif from './ornaments/MehndiMotif.astro';
import site from '../data/site.json';
---

<section id="top" class="hero">
  <CornerFloral class="botanical top-0 left-0 w-40 md:w-64" />
  <CornerFloral class="botanical right-0 bottom-0 w-40 rotate-180 md:w-64" />
  <MehndiMotif class="pointer-events-none absolute -top-2 right-6 w-40 text-beige opacity-40 md:right-16 md:w-56" />

  <div class="hero-shell shell relative z-10">
    <div class="arch-panel arched has-text-over mx-auto max-w-4xl">
      <div class="arch-rule pointer-events-none absolute inset-0" aria-hidden="true"></div>

      <div class="relative">
        <h1 class="hero-title">
          <span class="script block text-forest">Intricate Mehndi</span>
          <span class="block text-espresso">Timeless Beauty</span>
        </h1>

        <div class="hero-divider"><OrnateDivider /></div>

        <p class="hero-description lede mx-auto text-center text-espresso">{site.description}</p>

        <div class="hero-actions flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a href="#contact" class="btn btn-primary w-full sm:w-auto">Book a Consultation</a>
          <a href="#gallery" class="btn btn-ghost w-full sm:w-auto">Explore My Work</a>
        </div>
        <p class="hero-availability text-forest">{site.availability}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
  }

  .hero-shell {
    padding-block: clamp(2rem, 5vw, 4.5rem) clamp(3.5rem, 7vw, 6rem);
  }

  .arch-panel {
    position: relative;
    background: var(--color-surface);
    padding: clamp(4.5rem, 9vw, 7rem) clamp(1.25rem, 5vw, 4rem) clamp(2.5rem, 5vw, 4rem);
    border: 1px solid color-mix(in srgb, var(--color-gold) 45%, transparent);
    box-shadow: 0 20px 60px -30px color-mix(in srgb, var(--color-emerald) 40%, transparent);
  }

  :global(.theme-dark) .arch-panel {
    box-shadow: none;
  }

  .hero-title {
    font-size: clamp(2rem, 7.6vw, 5.25rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
    text-align: center;
  }

  .hero-title .script {
    font-size: 0.88em;
    line-height: 1.45;
    letter-spacing: 0;
  }

  .hero-divider {
    margin-block: clamp(1.25rem, 3vw, 2rem);
  }

  .hero-description {
    max-width: 42ch;
    font-size: clamp(1rem, 1.6vw, 1.125rem);
  }

  .hero-actions {
    margin-top: 1.75rem;
  }

  .hero-availability {
    margin: 1.25rem auto 0;
    font-size: 0.8125rem;
    text-align: center;
    letter-spacing: 0.04em;
  }
</style>

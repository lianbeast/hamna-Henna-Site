---
interface Tier {
  name: string;
  blurb: string;
  features: string[];
  featured?: boolean;
  note?: string;
}

const tiers: Tier[] = [
  {
    name: 'Occasion Design',
    blurb: 'A single hand or small piece for engagements, sangeet, or a special night out.',
    features: ['Single-hand or mini design', 'Lighter, faster session', 'Evening-friendly motifs'],
    note: 'Often booked 1–3 weeks out.'
  },
  {
    name: 'Engagement & Sangeet',
    blurb: 'Both hands in designs made for the evening — elegant, not overwhelming.',
    features: ['Both hands, composed to order', 'Traditional or contemporary', '2–3 hour session'],
    note: 'Usually booked 1–2 months out.'
  },
  {
    name: 'Bridal Set',
    blurb: 'The full composition — hands and feet, drawn to order for the wedding day.',
    features: ['Hands + feet, full coverage', 'Motif consultation before the day', '2–4 hour session'],
    note: 'Dates held months in advance — inquire early.',
    featured: true
  },
  {
    name: 'Bridal Party',
    blurb: 'Coordinated sets for maids, mothers, and sisters that read as one family of designs.',
    features: ['Unified motif family', 'Per-hand rate drops as the party grows', 'Scheduled around the bridal set'],
    note: 'Include party size in your inquiry.'
  },
  {
    name: 'Natural / Organic',
    blurb: 'The same hand, in a gentler formula — organic, clove-free paste for sensitive skin.',
    features: ['Clove-free organic paste', 'Patch test on request', 'Any of the above designs'],
    note: 'Mention sensitivities in your inquiry.'
  }
];
---

<section class="section-wrap" aria-labelledby="pricing-heading">
  <div class="glass-panel">
    <p class="section-label label">The Rates</p>
    <h2 id="pricing-heading" class="section-h2">Every set, quoted to order.</h2>
    <p class="pricing-intro">
      Work is composed by coverage, detail, and travel — so each set is quoted individually.
      Start with an inquiry; Hamna replies within 48 hours with a number for your exact day.
    </p>

    <div class="pricing-grid">
      {tiers.map((t) => (
        <article class={`pricing-card${t.featured ? ' pricing-card--featured' : ''}`}>
          <div class="pricing-head">
            <h3 class="pricing-name">{t.name}</h3>
            <p class="pricing-amount">Custom quote</p>
          </div>
          <p class="pricing-blurb">{t.blurb}</p>
          <ul class="pricing-feats">
            {t.features.map((f) => (
              <li>{f}</li>
            ))}
          </ul>
          <p class="pricing-note">{t.note}</p>
          <a class="pricing-cta" href="#booking-heading">Request a quote</a>
        </article>
      ))}
    </div>

    <p class="pricing-foot">
      Destination weddings and travel are quoted case by case — see the
      <a href="#faq-heading">FAQ</a> for booking, deposits, and aftercare.
    </p>
  </div>
</section>

<style>
  .pricing-intro {
    font-size: 15px;
    font-style: italic;
    color: var(--color-clay);
    margin: 0 0 22px;
    max-width: 56ch;
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    align-items: stretch;
  }

  .pricing-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px;
    background: rgba(251, 244, 231, 0.5);
    border-radius: 14px;
    border: 1px solid rgba(221, 201, 168, 0.35);
    transition: transform 0.3s ease, background-color 0.45s ease, border-color 0.45s ease, box-shadow 0.45s ease;
  }
  .pricing-card:hover {
    transform: translateY(-3px);
  }

  .pricing-card--featured {
    border-color: rgba(194, 154, 75, 0.65);
    background: linear-gradient(180deg, rgba(251, 244, 231, 0.65), rgba(244, 230, 205, 0.45));
    box-shadow: 0 18px 40px -24px rgba(140, 46, 42, 0.45);
  }

  .pricing-head {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .pricing-name {
    font-size: 17px;
    font-weight: 600;
    color: var(--color-henna);
    margin: 0;
  }
  .pricing-amount {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin: 0;
  }

  .pricing-blurb {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--color-clay);
    margin: 0;
  }

  .pricing-feats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 13.5px;
    color: var(--color-inkbrown);
  }
  .pricing-feats li {
    padding-left: 18px;
    position: relative;
  }
  .pricing-feats li::before {
    content: '•';
    position: absolute;
    left: 4px;
    color: var(--color-rust);
  }

  .pricing-note {
    font-size: 12px;
    font-style: italic;
    color: var(--color-clay);
    margin: 2px 0 0;
  }

  .pricing-cta {
    margin-top: auto;
    display: inline-block;
    align-self: flex-start;
    padding: 9px 18px;
    border-radius: 999px;
    background: var(--color-henna);
    color: #fdf8ee;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    border: 1px solid rgba(194, 154, 75, 0.55);
    box-shadow: 0 8px 20px -12px rgba(140, 46, 42, 0.6);
    transition: transform 0.25s ease, background-color 0.45s ease, border-color 0.45s ease;
  }
  .pricing-cta:hover {
    transform: translateY(-2px);
  }

  .pricing-foot {
    margin: 18px 0 0;
    font-size: 13px;
    font-style: italic;
    color: var(--color-clay);
  }
  .pricing-foot a {
    color: var(--color-henna);
    text-decoration: underline;
    text-decoration-color: var(--color-rust);
    text-underline-offset: 3px;
  }

  @media (max-width: 900px) {
    .pricing-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .pricing-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

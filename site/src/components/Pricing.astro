---
import Ornament from './Ornament.astro';

interface Tier {
  name: string;
  blurb: string;
  features: string[];
  featured?: boolean;
}

const tiers: Tier[] = [
  {
    name: 'Bridal Essentials',
    blurb: 'Full hand and foot artistry composed to order. Includes one design with traditional or contemporary motifs tailored to the bride.',
    features: ['One full-hand design', 'Custom motif consultation', 'Aftercare guide', 'Booking deposit included'],
    featured: false
  },
  {
    name: 'Bridal Party Coordination',
    blurb: 'Coordinated designs for maids, mothers, and sisters — a unified set that ties the celebration together.',
    features: ['Designs for up to 5 party members', 'Unified motif family', 'Reduced per-hand rate', 'Scheduling coordination'],
    featured: false
  },
  {
    name: 'Elite Experience',
    blurb: 'Top-tier service with full hand + foot, faster turnaround, and exclusive motif library.',
    features: ['Hand + foot design', 'Exclusive motif library', 'Expedited schedule', 'Gift box + card'],
    featured: true
  }
];
---

<section class="section" aria-labelledby="pricing-heading">
  <p class="eyebrow">Pricing</p>
  <h2 id="pricing-heading" class="section-title">Three tiers, one starting point.</h2>
  <p class="intro">
    Choose a tier or request a custom quote. Each tier includes a deposit to hold the date.
  </p>

  <div class="pricing-grid">
    {tiers.map((t) => (
      <article class={`pricing-card${t.featured ? ' pricing-card--featured' : ''}`} aria-labelledby={`card-${t.name.replace(/\s+/g, '-')}`}>
        <div class="pricing-head">
          <h3 class="pricing-name">{t.name}</h3>
          <p class="pricing-amount">From ${t.features.length * 120}</p>
        </div>
        <p class="pricing-blurb">{t.blurb}</p>
        <ul class="pricing-feats">
          {t.features.map((f) => (
            <li>{f}</li>
          ))}
        </ul>
        {t.note && <p class="pricing-note">{t.note}</p>}
        <a class="pricing-cta" href="#booking-heading" aria-label="Select {t.name} tier">
          Choose this tier
        </a>
      </article>
    ))}
  </div>

  <p class="pricing-foot">
    See the <a href="#faq-heading">FAQ</a> for booking, deposits, and aftercare.
  </p>
</section>

<style>
  .pricing-intro {
    font-size: 15px;
    font-style: italic;
    color: var(--color-clay);
    margin: 0 0 var(--space-lg);
    max-width: 56ch;
  }
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
    align-items: stretch;
  }
  @media (max-width: 900px) {
    .pricing-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .pricing-grid { grid-template-columns: 1fr; }
  }
  .pricing-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-lg);
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    transition: transform 0.25s ease, background 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    box-shadow: var(--shadow-card);
  }
  .pricing-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-float);
  }
  .pricing-card--featured {
    border-color: var(--color-gold);
    background: linear-gradient(180deg, rgba(243, 234, 224, 0.65), rgba(237, 224, 204, 0.45));
    box-shadow: 0 18px 40px -24px rgba(184, 148, 74, 0.45);
  }
  .pricing-head {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .pricing-name {
    font-size: 17px;
    font-weight: 600;
    color: var(--color-henna);
    margin: 0;
  }
  .pricing-amount {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin: 0;
  }
  .pricing-blurb {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--color-clay);
    margin: 0;
  }
  .pricing-feats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 13.5px;
    color: var(--color-ink);
  }
  .pricing-feats li {
    padding-left: 18px;
    position: relative;
  }
  .pricing-feats li::before {
    content: '•';
    position: absolute;
    left: 4px;
    color: var(--color-rust);
  }
  .pricing-note {
    font-size: 12px;
    font-style: italic;
    color: var(--color-clay);
    margin: 2px 0 0;
  }
  .pricing-cta {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 22px;
    border-radius: var(--radius-pill);
    background: var(--color-henna);
    color: var(--color-ivory);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
    border: none;
    transition: background 0.18s ease, transform 0.18s ease;
  }
  .pricing-cta:hover {
    background: var(--color-rust);
    transform: translateY(-1px);
  }
  .pricing-foot {
    margin: var(--space-lg) 0 0;
    font-size: 13px;
    font-style: italic;
    color: var(--color-clay);
  }
  .pricing-foot a {
    color: var(--color-henna);
    text-decoration: underline;
    text-decoration-color: var(--color-rust);
    text-underline-offset: 3px;
  }
</style>
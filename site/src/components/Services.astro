---
const services = [
  { n: '01', title: 'Service One', desc: 'A short description of the first offering. Replace this text with what you actually deliver.', note: 'Edit in Services.astro.' },
  { n: '02', title: 'Service Two', desc: 'A second offering. Keep this sentence under two lines so the grid stays balanced.', note: 'Edit in Services.astro.' },
  { n: '03', title: 'Service Three', desc: 'A third offering. Use this card to highlight an evening or short-form option.', note: 'Edit in Services.astro.' },
  { n: '04', title: 'Service Four', desc: 'A fourth offering. Remove the entire entry from the array if you do not need four.', note: 'Edit in Services.astro.' }
];
---

<section class="section-wrap" aria-labelledby="services-heading">
  <div class="glass-panel">
    <p class="section-label label">The Services</p>
    <h2 id="services-heading" class="section-h2">Four ways to work together</h2>
    <ol class="svc-list">
      {services.map((s) => (
        <li class="svc-entry">
          <div class="svc-row">
            <span class="svc-n counter" data-count={parseInt(s.n, 10)}>{s.n}</span>
            <h3 class="svc-title">{s.title}</h3>
          </div>
          <p class="svc-desc">{s.desc}</p>
          <p class="svc-note">{s.note}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

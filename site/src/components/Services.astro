---
import Ornament from './Ornament.astro';

const services = [
  {
    n: '01',
    title: 'Bridal Mehndi',
    desc: 'Full hand and foot artistry, composed to order for the wedding day. Traditional or contemporary motifs tailored to the bride.',
    note: 'Composed to order.'
  },
  {
    n: '02',
    title: 'Bridal Party Coordination',
    desc: 'Coordinated designs for maids, mothers, and sisters - a unified set that ties the celebration together.',
    note: 'By the party.'
  },
  {
    n: '03',
    title: 'Engagement & Sangeet',
    desc: 'Occasion designs for engagement nights and sangeet - lighter, faster, made for the evening.',
    note: 'By the evening.'
  },
  {
    n: '04',
    title: 'Natural / Organic Henna',
    desc: 'Organic, clove-free paste for sensitive brides and skin. Drawn in the same hand, in a gentler formula.',
    note: 'By arrangement.'
  }
];
---

<section class="folio-services" aria-labelledby="services-heading">
  <Ornament variant="rule" />
  <p class="folio-label label">The Services</p>
  <h2 id="services-heading" class="folio-h2">Four ways Hamna's hand works.</h2>

  <ol class="folio-service-list" aria-label="Service list">
    {services.map((s) => (
      <li class="folio-service-entry" key={s.n}>
        <div class="folio-service-row">
          <span class="folio-service-n" aria-hidden="true">{s.n}</span>
          <h3 class="folio-service-title">{s.title}</h3>
        </div>
        <p class="folio-service-desc">{s.desc}</p>
        <p class="folio-service-note">{s.note}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .folio-services {
    margin: 56px 0;
  }

  .folio-label {
    color: var(--color-henna);
    margin: 24px 0 8px;
  }

  .label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .folio-h2 {
    font-size: clamp(22px, 3.6vw, 30px);
    font-weight: 600;
    color: var(--color-ink);
    margin: 0 0 24px;
    text-wrap: balance;
  }

  .folio-service-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
  }

  .folio-service-entry {
    background: var(--color-paper);
    border: 1px solid var(--color-sandline);
    border-radius: var(--radius-md);
    padding: 24px;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .folio-service-entry:hover {
    border-color: var(--color-henna);
    background: color-mix(in srgb, var(--color-henna) 5%, var(--color-paper));
  }

  .folio-service-row {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 6px;
  }

  /* Circular plate badge, echoing the hero stamp. Fixed dark plate so it
     holds its identity in both themes; plate-gold numeral is 8.1:1 on ink. */
  .folio-service-n {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--plate-gold);
    background: var(--plate-ink);
    color: var(--plate-gold);
    font-size: 17px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.06em;
  }

  .folio-service-title {
    font-size: clamp(20px, 3.4vw, 24px);
    font-weight: 600;
    color: var(--color-ink);
    margin: 0;
    text-wrap: balance;
  }

  .folio-service-desc {
    font-size: 15px;
    color: var(--color-clay);
    line-height: 1.55;
    max-width: 46ch;
    margin: 6px 0 6px;
  }

  .folio-service-note {
    font-size: 13px;
    font-style: italic;
    color: var(--color-henna);
    margin: 0;
  }

  @media (max-width: 600px) {
    .folio-service-list {
      grid-template-columns: 1fr;
    }
  }
</style>
---
const year = new Date().getFullYear();
---
<footer class="footer-wrap">
  <div class="glass-panel footer-panel">
    <div class="footer-row">
      <p class="footer-quote">The stain is drawn into the day.</p>
      <div class="footer-contact">
        <a href="tel:+13015554321" class="footer-phone">301.555.4321</a>
        <a href="https://www.instagram.com/dmvflowerbar/" target="_blank" rel="noopener" class="footer-ig">@dmvflowerbar</a>
      </div>
    </div>
    <p class="footer-copy">© {year} Henna by Hamna. The Craft Book, Folio I.</p>
  </div>
</footer>
<style>
  .footer-wrap {
    margin-top: 80px;
    padding-bottom: 56px;
  }
  .footer-panel {
    padding: 36px clamp(28px, 5vw, 48px);
    transition: background-color 0.45s ease, border-color 0.45s ease;
  }
  .footer-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    margin-bottom: 20px;
  }
  .footer-quote {
    font-size: clamp(22px, 4vw, 32px);
    font-weight: 600;
    color: var(--color-henna);
    margin: 0;
    text-wrap: balance;
  }
  .footer-contact {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
    flex-shrink: 0;
  }
  .footer-phone {
    font-size: 16px;
    font-weight: 600;
    color: var(--color-inkbrown);
    text-decoration: none;
    border-bottom: 2px solid var(--color-rust);
    padding-bottom: 2px;
    font-variant-numeric: tabular-nums;
    transition: color 0.2s;
  }
  .footer-phone:hover { color: var(--color-henna); }
  .footer-ig {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-clay);
    text-decoration: none;
    transition: color 0.2s;
  }
  .footer-ig:hover { color: var(--color-henna); }
  .footer-copy {
    font-size: 12px;
    color: var(--color-clay);
    margin: 0;
    letter-spacing: 0.06em;
    padding-top: 14px;
    border-top: 1px solid rgba(221, 201, 168, 0.4);
    transition: border-color 0.45s ease, color 0.45s ease;
  }
  @media (max-width: 640px) {
    .footer-row {
      flex-direction: column;
      align-items: flex-start;
    }
    .footer-contact {
      align-items: flex-start;
    }
  }
</style>
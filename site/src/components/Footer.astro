---
const year = new Date().getFullYear();
---

<footer class="footer" role="contentinfo" aria-label="Footer for Henna by Hamna">
  <div class="footer-rule"></div>
  <div class="footer-row">
    <p class="footer-quote">The stain is drawn into the day.</p>
    <div class="footer-contact">
      <a href="tel:+13015554321" class="footer-phone">301.555.4321</a>
      <a href="https://www.instagram.com/henna-designer/" target="_blank" rel="noopener" class="footer-ig">@henna-designer</a>
    </div>
  </div>
  <p class="footer-copy">© {year} Henna by Hamna. The Craft Book, Folio I.</p>
</footer>

<style>
  .footer {
    margin-top: var(--space-xl);
    padding: var(--space-xl) 0 var(--space-md);
  }
  .footer-rule {
    height: 2px;
    background: var(--color-sandline);
    margin-bottom: var(--space-md);
  }
  .footer-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-lg);
    margin-bottom: var(--space-lg);
    flex-wrap: wrap;
  }
  @media (max-width: 600px) {
    .footer-row {
      flex-direction: column;
      align-items: flex-start;
    }
    .footer-contact {
      align-items: flex-start;
    }
  }
  .footer-quote {
    font-size: clamp(26px, 4vw, 36px);
    font-weight: 600;
    color: var(--color-henna);
    margin: 0;
    text-wrap: balance;
  }
  .footer-contact {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-sm);
  }
  .footer-phone {
    font-size: 17px;
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 2px solid var(--color-rust);
    padding-bottom: 2px;
    font-variant-numeric: tabular-nums;
  }
  .footer-phone:hover { color: var(--color-henna); }
  .footer-ig {
    font-size: 14px;
    color: var(--color-clay);
    text-decoration: none;
  }
  .footer-ig:hover { color: var(--color-henna); }
  .footer-copy {
    font-size: 12px;
    color: var(--color-clay);
    margin: var(--space-xl) 0 0;
    letter-spacing: 0.06em;
    text-align: center;
    max-width: 64ch;
    margin-left: auto;
    margin-right: auto;
  }
</style>
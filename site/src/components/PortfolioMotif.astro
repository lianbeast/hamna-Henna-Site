---
/**
 * Renders one portfolio drawing inline, recoloured to the design tokens.
 *
 * The shipped drawings in public/portfolio are opaque cream with hardcoded
 * henna red and gold. Referenced through <img> they would be six cream
 * squares glaring off a near-black dark mode, and an <img>-referenced SVG
 * cannot read a CSS var. Inlining and swapping the literal hex for tokens is
 * the same move MotifPlaceholder.astro already makes, and it also removes the
 * base-path problem: there is no URL to resolve.
 */
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

interface Props {
  file: string;
  alt: string;
  class?: string;
}

const { file, alt, class: className = '' } = Astro.props;

// Read from the project's public dir, which is where the build runs. Using
// import.meta.url here points at dist/ once the page is being rendered, and
// Astro 7 has no exported publicDir helper to fall back on.
const raw = readFileSync(resolve(process.cwd(), 'public/portfolio', file), 'utf8');

// The drawings are standalone documents: drop the XML-ish prolog, the fixed
// width/height (the frame below owns the box so there is no layout shift) and
// the comments, then hand the paths to the frame.
const body = raw
  .replace(/<\?xml[^>]*\?>/g, '')
  .replace(/<!--[\s\S]*?-->/g, '')
  .replace(/\swidth="\d+"/, '')
  .replace(/\sheight="\d+"/, '')
  .replace(
    /#fbf4e7/gi,
    'var(--folio-plate)'
  )
  .replace(
    /#8C2E2A/gi,
    'var(--folio-line)'
  )
  .replace(
    /#C29A4B/gi,
    'var(--folio-accent)'
  )
  .replace('</svg>', '');
---

<figure class={`folio-plate ${className}`}>
  <!-- Decorative in context: the caption already names the motif, and the
       grid is a gallery, so the drawing's meaning is carried by its alt. -->
  <svg
    class="folio-plate-art"
    viewBox="0 0 800 800"
    role="img"
    aria-label={alt}
    xmlns="http://www.w3.org/2000/svg"
    set:html={body}
  />
</figure>

<style>
  .folio-plate {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    background: var(--folio-plate);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
  }
  .folio-plate-art {
    display: block;
    width: 100%;
    height: 100%;
  }
  .folio-plate-art :global(path),
  .folio-plate-art :global(circle) {
    /* The mark rests fully drawn. The reveal below is additive — a browser
       without scroll-driven animation, or a reader who asked for reduced
       motion, never sees anything but the finished drawing. */
    stroke-dashoffset: 0;
  }

  /* Henna is nothing but a line laid down in one pass, so the drawings are
     drawn on rather than faded up. Each card keys off its own position in the
     scroll, so the grid staggers itself with no per-card delay to get wrong.
     2000 clears the longest path in an 800-unit viewBox. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .folio-plate-art :global(path),
      .folio-plate-art :global(circle) {
        animation: folio-draw linear both;
        animation-timeline: view();
        animation-range: entry 8% cover 42%;
        stroke-dasharray: 2000;
      }
      .folio-plate-art :global(circle) { stroke-dasharray: none; }
      /* A solid dot has no path to walk, so it fades in with the stroke it
         sits on rather than wiping a circumference. */
      .folio-plate-art :global(circle[fill]:not([fill='none'])) {
        animation-name: folio-ink;
      }
      @keyframes folio-ink {
        from { opacity: 0; }
        to { opacity: 1; }
      }

      @keyframes folio-draw {
        from { stroke-dashoffset: 2000; }
        to { stroke-dashoffset: 0; }
      }
    }
  }
</style>

---
import Ornament from './Ornament.astro';
import MotifPlaceholder from './MotifPlaceholder.astro';

interface PortfolioItem {
  src: string;
  alt: string;
  motif?: 'curl' | 'paisley' | 'mandala' | 'vine';
  year?: number;
}

const items = (await import('../data/portfolio.json')).default as PortfolioItem[];
const motifs: Array<'curl' | 'paisley' | 'mandala' | 'vine'> = ['curl', 'paisley', 'mandala', 'vine', 'curl', 'paisley'];
---

<section class="section" aria-labelledby="portfolio-heading">
  <p class="eyebrow">The Portfolio</p>
  <h2 id="portfolio-heading" class="section-title">Recent hands, recent days.</h2>

  <div class="folio-portfolio-grid" role="list">
    {items.length === 0 ? (
      <div class="folio-portfolio-empty" role="status">
        <p class="folio-empty-line">
          Portfolio arriving soon — follow <a href="https://www.instagram.com/henna-designer/" target="_blank" rel="noopener">@henna-designer</a> for the latest work.
        </p>
        <div class="folio-portfolio-grid-skeleton" aria-hidden="true">
          {motifs.map((m, i) => (
            <MotifPlaceholder motif={m} label={`Henna motif placeholder ${i + 1}`} />
          ))}
        </div>
      </div>
    ) : (
      items.map((item, i) => (
        <figure class="folio-portfolio-card" role="listitem" key={item.src}>
          <img src={item.src} alt={item.alt} loading={i < 3 ? 'eager' : 'lazy'} width={600} height={800} />
          <figcaption class="folio-portfolio-caption">
            <span class="folio-portfolio-caption-motif">{item.motif || 'mixed'}</span>
            {item.year && <span class="folio-portfolio-caption-year">{item.year}</span>}
          </figcaption>
        </figure>
      ))
    )}
  </div>
</section>

<style>
  .folio-portfolio-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }
  @media (min-width: 640px) {
    .folio-portfolio-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .folio-portfolio-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .folio-portfolio-empty {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }
  .folio-empty-line {
    font-size: 14px;
    font-style: italic;
    color: var(--color-clay);
    margin: 0;
    max-width: 52ch;
  }
  .folio-empty-line a {
    color: var(--color-henna);
    text-decoration: underline;
    text-decoration-color: var(--color-rust);
    text-underline-offset: 3px;
  }
  .folio-portfolio-grid-skeleton {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }
  @media (min-width: 640px) {
    .folio-portfolio-grid-skeleton { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .folio-portfolio-grid-skeleton { grid-template-columns: repeat(3, 1fr); }
  }

  .folio-portfolio-card {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    box-shadow: var(--shadow-soft);
    transition: box-shadow 0.3s ease, transform 0.3s ease, border-color 0.3s ease;
  }
  .folio-portfolio-card:hover,
  .folio-portfolio-card:focus-within {
    box-shadow: var(--shadow-float);
    transform: translateY(-2px);
    border-color: var(--color-sandline);
  }
  .folio-portfolio-card img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .folio-portfolio-card:hover img { transform: scale(1.03); }

  .folio-portfolio-caption {
    position: absolute;
    inset: auto 0 0 0;
    padding: 14px 18px;
    background: linear-gradient(to top, rgba(44, 36, 27, 0.85), transparent);
    color: var(--color-ivory);
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 13px;
    line-height: 1.5;
  }
  .folio-portfolio-caption-motif {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 11px;
    opacity: 0.85;
  }
  .folio-portfolio-caption-year { opacity: 0.7; font-variant-numeric: tabular-nums; }
</style>
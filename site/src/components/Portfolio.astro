---
import Ornament from './Ornament.astro';
import MotifPlaceholder from './MotifPlaceholder.astro';

interface PortfolioItem {
  src: string;
  alt: string;
  motif?: 'curl' | 'paisley' | 'mandala' | 'vine';
  year?: number;
}

const items = (await import('../data/portfolio.json')).default as PortfolioItem[];
const motifs: Array<'curl' | 'paisley' | 'mandala' | 'vine'> = ['curl', 'paisley', 'mandala', 'vine', 'curl', 'paisley'];
---

<section class="folio-portfolio" aria-labelledby="portfolio-heading">
  <Ornament variant="rule" />
  <p class="folio-label label">The Portfolio</p>
  <h2 id="portfolio-heading" class="folio-h2">Recent hands, recent days.</h2>

  <div class="folio-portfolio-grid" role="grid">
    {items.length === 0 ? (
      <div class="folio-portfolio-empty" role="status">
        <p class="folio-empty-line">
          Portfolio arriving soon - follow <a href="https://www.instagram.com/henna-designer/" target="_blank" rel="noopener">@henna-designer</a> for the latest work.
        </p>
        <div class="folio-portfolio-grid-skeleton" aria-hidden="true">
          {motifs.map((m, i) => (
            <MotifPlaceholder motif={m} label={`Henna motif placeholder ${i + 1}`} />
          ))}
        </div>
      </div>
    ) : (
      <div class="folio-portfolio-grid-view" role="grid">
        {items.map((item, i) => (
          <figure class="folio-portfolio-card" role="group" aria-label={`Henna design ${item.alt}, ${item.year || ''}`} key={item.src}>
            <img src={item.src} alt={item.alt} loading="lazy" width={500} height={340} />
            <figcaption class="folio-portfolio-caption">
              <span class="folio-portfolio-caption-motif">{item.motif || 'mixed'}</span>
              {item.year && <span class="folio-portfolio-caption-year">{item.year}</span>}
            </figcaption>
          </figure>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .folio-portfolio {
    margin: 56px 0;
  }

  .folio-label {
    color: var(--color-henna);
    margin: 24px 0 8px;
  }

  .label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .folio-h2 {
    font-size: clamp(22px, 3.6vw, 30px);
    font-weight: 600;
    color: var(--color-inkbrown);
    margin: 0 0 24px;
    text-wrap: balance;
  }

  .folio-portfolio-grid {
    display: grid;
    gap: 18px;
  }

  @media (min-width: 768px) {
    .folio-portfolio-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .folio-portfolio-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .folio-portfolio-empty {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .folio-empty-line {
    font-size: 14px;
    font-style: italic;
    color: var(--color-clay);
    margin: 0;
  }

  .folio-empty-line a {
    color: var(--color-henna);
    text-decoration: underline;
    text-decoration-color: var(--color-rust);
    text-underline-offset: 3px;
  }

  .folio-portfolio-grid-skeleton {
    display: grid;
    gap: 18px;
  }

  @media (min-width: 768px) {
    .folio-portfolio-grid-skeleton {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .folio-portfolio-grid-skeleton {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .folio-portfolio-card {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    background: var(--color-paper);
  }

  .folio-portfolio-card img {
    display: block;
    width: 100%;
    height: 220px;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .folio-portfolio-card:hover img {
    transform: scale(1.05);
  }

  .folio-portfolio-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 12px 16px;
    background: linear-gradient(transparent, rgba(45, 45, 45, 0.85));
    color: var(--color-ivory);
    font-size: 13px;
    line-height: 1.5;
  }

  .folio-portfolio-caption-motif {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.8;
  }

  .folio-portfolio-caption-year {
    font-size: 12px;
    opacity: 0.7;
    margin-left: 4px;
  }

  @media (max-width: 600px) {
    .folio-portfolio-card img {
      height: 180px;
    }
  }
</style>
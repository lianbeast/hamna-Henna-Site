---
import packages from '../data/packages.json';
import OrnateDivider from './ornaments/OrnateDivider.astro';

const ordered = [...packages].sort((a, b) => Number(b.featured) - Number(a.featured));
---

<section id="packages" class="section bg-cream">
  <div class="shell">
    <header class="reveal mx-auto max-w-2xl text-center">
      <p class="eyebrow text-forest">Collections</p>
      <h2 class="mt-4 text-4xl text-espresso md:text-5xl">Packages</h2>
      <div class="my-8"><OrnateDivider /></div>
      <p class="lede mx-auto text-espresso">
        Every package can be adjusted to your day. What you see here is the shape of the
        work, not a fixed menu.
      </p>
    </header>

    <ul class="mt-16 grid gap-6 lg:grid-cols-2">
      {
        ordered.map((p) => (
          <li class:list={['reveal card flex flex-col p-8 md:p-10', p.featured && 'card-featured']}>
            {p.featured && (
              <p class="eyebrow mb-4 text-forest">Most Requested</p>
            )}
            <h3 class="text-3xl text-espresso md:text-4xl">{p.name}</h3>
            <p class="script mt-1 text-xl text-forest">{p.tagline}</p>
            <p class="mt-5 text-espresso/85">{p.description}</p>

            <ul class="mt-6 space-y-2.5">
              {p.includes.map((item) => (
                <li class="flex gap-3 text-espresso/90">
                  <svg
                    class="mt-1 shrink-0 text-forest"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path d="M20 6L9 17l-5-5" />
                  </svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>

            <div class="mt-9 flex items-end justify-between gap-4 border-t border-gold/30 pt-6">
              <span class="font-[family-name:var(--font-display)] text-2xl text-espresso">
                {p.price}
              </span>
              <a href="#contact" class="btn btn-primary">Request a Quote</a>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

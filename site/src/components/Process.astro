---
import Ornament from './Ornament.astro';
---
<section class="folio-process" aria-labelledby="process-heading">
  <Ornament variant="rule" />
  <p class="folio-label label">The Process</p>
  <h2 id="process-heading" class="folio-h2">From the first note to the last line.</h2>

  <ol class="folio-process-steps" aria-label="Booking process steps">
    {steps.map((s) => (
      <li class="folio-process-step" tabindex="0" role="button" aria-expanded="false" key={s.n}>
        <div class="folio-process-row">
          <span class="folio-process-n">{s.n}</span>
          <h3 class="folio-process-title">{s.title}</h3>
        </div>
        <p class="folio-process-desc">{s.body}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .folio-process {
    margin: 56px 0;
  }

  .folio-label {
    color: var(--color-henna);
    margin: 24px 0 8px;
  }

  .label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .folio-h2 {
    font-size: clamp(22px, 3.6vw, 30px);
    font-weight: 600;
    color: var(--color-inkbrown);
    margin: 0 0 24px;
    text-wrap: balance;
  }

  .folio-process-steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .folio-process-step {
    @apply bg-[var(--color-paper)] border border-[var(--color-sandline)] rounded-xl p-6 transition-all hover:border-[var(--color-henna)] hover:bg-[var(--color-henna)/5] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-rust)] focus-visible:ring-offset-2;
    cursor: pointer;
  }

  .folio-process-step:focus-visible {
    outline: 2px solid var(--color-rust);
    outline-offset: 2px;
  }

  .folio-process-row {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 16px 20px;
    align-items: start;
  }

  .folio-process-n {
    font-size: 22px;
    font-weight: 600;
    color: var(--color-gold);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
  }

  .folio-process-title {
    font-size: clamp(18px, 2.8vw, 22px);
    font-weight: 600;
    color: var(--color-henna);
    margin: 0 0 6px;
  }

  .folio-process-desc {
    font-size: 15px;
    color: var(--color-clay);
    line-height: 1.55;
    margin: 0;
    max-width: 52ch;
  }

  @media (max-width: 600px) {
    .folio-process-step {
      grid-template-columns: 1fr;
    }
  }
</style>
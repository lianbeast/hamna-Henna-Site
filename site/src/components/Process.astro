---
const steps = [
  {
    n: '01',
    title: 'Reach out',
    body: 'Send a note with your date and what you have in mind. Hamna replies within 48 hours.'
  },
  {
    n: '02',
    title: 'Book the date',
    body: 'Once the date is held, a deposit secures it. Bridal dates are held months in advance.'
  },
  {
    n: '03',
    title: 'Compose the design',
    body: 'Hands, feet, and the story they tell are composed to order. Nothing is printed or traced.'
  },
  {
    n: '04',
    title: 'The day',
    body: 'The work is drawn by hand in the artist\'s own paste, one bride at a time. Aftercare is included.'
  }
];
---

<section class="section" aria-labelledby="process-heading">
  <h2 id="process-heading" class="section-title">From the first note to the last line.</h2>

  <ol class="step-list" aria-label="Booking process steps">
    {steps.map((s) => (
      <li class="step-card" key={s.n}>
        <div class="step-row">
          <span class="step-num">{s.n}</span>
          <div>
            <h3 class="step-title">{s.title}</h3>
            <p class="step-body">{s.body}</p>
          </div>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .step-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
  .step-card {
    padding: var(--space-lg);
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    transition: border-color 0.25s ease, background 0.3s ease, box-shadow 0.25s ease;
  }
  .step-card:hover {
    border-color: var(--color-sandline);
    box-shadow: var(--shadow-card);
  }
  .step-title {
    font-size: clamp(18px, 2.6vw, 22px);
    font-weight: 600;
    color: var(--color-ink);
    margin: 0 0 6px;
  }
  .step-body {
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-clay);
    margin: 0;
    max-width: 52ch;
  }
</style>
---
import '../styles/global.css';
import site from '../data/site.json';

const { title, description = site.description } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/textures/paisley.svg', Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  description: site.description,
  email: `mailto:${site.email}`,
  telephone: site.phone,
  url: Astro.site?.toString(),
  knowsAbout: ['Bridal mehndi', 'Henna artistry', 'Arabic mehndi', 'Wedding henna'],
  sameAs: [site.instagram, site.pinterest, site.tiktok],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ?? `${site.name} — ${site.tagline}`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500&family=Great+Vibes&family=Jost:wght@400;500&display=swap"
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <script is:inline>
      // set the theme before first paint so there is no flash
      (function () {
        try {
          var saved = localStorage.getItem('hbh-theme');
          var dark =
            saved === 'dark' ||
            (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches);
          if (dark) document.documentElement.classList.add('theme-dark');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>
    <slot />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 1000;
    padding: 0.75rem 1.25rem;
    background: var(--color-emerald);
    color: var(--color-floral);
  }

  .skip:focus {
    left: 0.5rem;
    top: 0.5rem;
  }
</style>

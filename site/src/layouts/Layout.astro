---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Henna by Hamna — henna artistry for the DMV. Simple, detailed, special-detailed and Arabic henna for Eid, Chaand-Raat, weddings, showers and special events. Custom designs available. Serving DC, Maryland and Virginia. Sister brand of @dmvflowerbar." />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,400&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <script is:inline>
      /* Apply the saved (or system) theme before first paint to avoid a light-mode flash. */
      (function () {
        try {
          var stored = localStorage.getItem('henna-theme');
          var dark =
            stored === 'dark' ||
            (stored === null && window.matchMedia('(prefers-color-scheme: dark)').matches);
          if (dark) document.documentElement.classList.add('theme-dark');
        } catch (e) { /* ignore */ }
      })();
    </script>
  </head>
  <body class="bg-ivory text-clay min-h-screen">
    <slot />
  </body>
</html>

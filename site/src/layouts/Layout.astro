---
import '../styles/global.css';
import { getBusinessProfile } from '../lib/supabase';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const profile = await getBusinessProfile();
const SITE_URL = 'https://lianbeast.github.io/hamna-Henna-Site';
const DEFAULT_DESCRIPTION = profile.tagline || 'A short, plain-Jane site.';

const { title, description = DEFAULT_DESCRIPTION, ogImage = '/og-image.png' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, SITE_URL);
const ogImageURL = new URL(ogImage, SITE_URL);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.business_name} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={profile.business_name} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:creator" content={profile.instagram_handle} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.png`} />

    <!-- PWA / Home Screen -->
    <link rel="manifest" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/manifest.webmanifest`} />
    <meta name="theme-color" content="#8c5123" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content={profile.business_name} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/icon-192.png`} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,400&display=swap" rel="stylesheet" />

    <!-- JSON-LD Structured Data (LocalBusiness) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": profile.business_name,
      "description": description,
      "url": SITE_URL,
      "image": ogImageURL.href,
      "brand": {
        "@type": "Organization",
        "name": profile.business_name,
        "url": `https://instagram.com/${profile.instagram_handle.replace('@', '')}`,
        "sameAs": [`https://instagram.com/${profile.instagram_handle.replace('@', '')}`]
      },
      "areaServed": [
        { "@type": "Place", "name": "Your Service Area" }
      ],
      "serviceType": [
        "Service One",
        "Service Two",
        "Service Three"
      ],
      "priceRange": "$$",
      "sameAs": [
        `https://instagram.com/${profile.instagram_handle.replace('@', '')}`
      ]
    })} />

    <!-- Apply saved theme before first paint -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('henna-theme');
          var dark =
            stored === 'dark' ||
            (stored === null && window.matchMedia('(prefers-color-scheme: dark)').matches);
          if (dark) document.documentElement.classList.add('theme-dark');
        } catch (e) { /* ignore */ }
      })();
   </script>
 </head>
  <body class="bg-ivory text-clay min-h-screen">
    <slot />
 </body>
</html>

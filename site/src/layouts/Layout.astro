---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const SITE_URL = 'https://lianbeast.github.io/hamna-Henna-Site';
const DEFAULT_DESCRIPTION = 'Henna by Hamna — henna artistry for the DMV. Simple, detailed, special-detailed and Arabic henna for Eid, Chaand-Raat, weddings, showers and special events. Custom designs available. Serving DC, Maryland and Virginia. Sister brand of @dmvflowerbar.';

const { title, description = DEFAULT_DESCRIPTION, ogImage = '/og-image.png' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, SITE_URL);
const ogImageURL = new URL(ogImage, SITE_URL);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Henna by Hamna" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Henna by Hamna" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:creator" content="@dmvflowerbar" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.png`} />

    <!-- PWA / Home Screen -->
    <link rel="manifest" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/manifest.webmanifest`} />
    <meta name="theme-color" content="#8c5123" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Henna by Hamna" />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/icon-192.png`} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,400&display=swap" rel="stylesheet" />

    <!-- JSON-LD Structured Data (LocalBusiness) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Henna by Hamna",
      "description": description,
      "url": SITE_URL,
      "image": ogImageURL.href,
      "brand": {
        "@type": "Organization",
        "name": "DMV Flower Bar",
        "url": "https://instagram.com/dmvflowerbar",
        "sameAs": ["https://instagram.com/dmvflowerbar"]
      },
      "areaServed": [
        { "@type": "State", "name": "District of Columbia" },
        { "@type": "State", "name": "Maryland" },
        { "@type": "State", "name": "Virginia" }
      ],
      "serviceType": [
        "Henna Art",
        "Bridal Henna",
        "Eid Henna",
        "Wedding Henna",
        "Party Henna",
        "Chaand-Raat Henna"
      ],
      "priceRange": "$$",
      "sameAs": [
        "https://instagram.com/dmvflowerbar"
      ]
    })} />

    <!-- Apply saved theme before first paint -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('henna-theme');
          var dark =
            stored === 'dark' ||
            (stored === null && window.matchMedia('(prefers-color-scheme: dark)').matches);
          if (dark) document.documentElement.classList.add('theme-dark');
        } catch (e) { /* ignore */ }
      })();
    </script>

    <!-- Splash screen styles (inline so they paint instantly) -->
    <style is:inline>
      .splash {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 28px;
        background: #f5ebdc;
        transition: opacity 0.6s ease, visibility 0.6s ease;
      }
      html.theme-dark .splash { background: #0f0c29; }

      .splash.is-hidden {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
      }

      /* ── Mandala SVG ─────────────────────────────────── */
      .splash-mandala {
        width: 140px;
        height: 140px;
        animation: splashSpin 6s linear infinite, splashPulse 2.4s ease-in-out infinite;
      }
      html.theme-dark .splash-mandala { filter: hue-rotate(200deg) brightness(1.2); }

      @keyframes splashSpin {
        from { transform: rotate(0deg); }
        to   { transform: rotate(360deg); }
      }
      @keyframes splashPulse {
        0%, 100% { transform: scale(1); opacity: 0.85; }
        50%      { transform: scale(1.06); opacity: 1; }
      }

      /* ── Text ────────────────────────────────────────── */
      .splash-title {
        font-family: 'Fraunces', serif;
        font-size: 26px;
        font-weight: 600;
        color: #643214;
        letter-spacing: 0.03em;
        opacity: 0;
        animation: splashFadeIn 0.8s 0.4s ease forwards;
      }
      html.theme-dark .splash-title { color: #c8a86e; }

      .splash-sub {
        font-size: 13px;
        color: #a07850;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        opacity: 0;
        animation: splashFadeIn 0.8s 0.7s ease forwards;
      }
      html.theme-dark .splash-sub { color: #7a6a9a; }

      @keyframes splashFadeIn {
        from { opacity: 0; transform: translateY(8px); }
        to   { opacity: 1; transform: translateY(0); }
      }

      /* ── Reduced motion ──────────────────────────────── */
      @media (prefers-reduced-motion: reduce) {
        .splash-mandala { animation: none; }
        .splash-title, .splash-sub { animation: none; opacity: 1; }
        .splash { transition-duration: 0.01s; }
      }
    </style>
  </head>
  <body class="bg-ivory text-clay min-h-screen">
    <!-- ── Splash Screen ──────────────────────────────── -->
    <div class="splash" id="splash" aria-hidden="true">
      <!-- Inline SVG mandala: 3 concentric rings of petals + dot ring -->
      <svg class="splash-mandala" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
        <!-- Outer petal ring (12 petals) -->
        <g fill="none" stroke="#b48232" stroke-width="1.2" opacity="0.7">
          {Array.from({ length: 12 }).map((_, i) => {
            const angle = (i * 30) * Math.PI / 180;
            const x1 = 100 + 60 * Math.cos(angle);
            const y1 = 100 + 60 * Math.sin(angle);
            const x2 = 100 + 85 * Math.cos(angle);
            const y2 = 100 + 85 * Math.sin(angle);
            const cx1 = 100 + 75 * Math.cos(angle - 0.3);
            const cy1 = 100 + 75 * Math.sin(angle - 0.3);
            const cx2 = 100 + 75 * Math.cos(angle + 0.3);
            const cy2 = 100 + 75 * Math.sin(angle + 0.3);
            return <path d={`M${x1},${y1} C${cx1},${cy1} ${cx2},${cy2} ${x2},${y2}`} />;
          })}
        </g>
        <!-- Middle petal ring (8 petals) -->
        <g fill="none" stroke="#a0522d" stroke-width="1.4" opacity="0.8">
          {Array.from({ length: 8 }).map((_, i) => {
            const angle = (i * 45 + 22.5) * Math.PI / 180;
            const x1 = 100 + 35 * Math.cos(angle);
            const y1 = 100 + 35 * Math.sin(angle);
            const x2 = 100 + 58 * Math.cos(angle);
            const y2 = 100 + 58 * Math.sin(angle);
            const cx1 = 100 + 48 * Math.cos(angle - 0.35);
            const cy1 = 100 + 48 * Math.sin(angle - 0.35);
            const cx2 = 100 + 48 * Math.cos(angle + 0.35);
            const cy2 = 100 + 48 * Math.sin(angle + 0.35);
            return <path d={`M${x1},${y1} C${cx1},${cy1} ${cx2},${cy2} ${x2},${y2}`} />;
          })}
        </g>
        <!-- Dot ring -->
        <g fill="#c87533" opacity="0.6">
          {Array.from({ length: 20 }).map((_, i) => {
            const angle = (i * 18) * Math.PI / 180;
            const cx = 100 + 72 * Math.cos(angle);
            const cy = 100 + 72 * Math.sin(angle);
            return <circle cx={cx} cy={cy} r="2" />;
          })}
        </g>
        <!-- Inner teardrop -->
        <ellipse cx="100" cy="92" rx="16" ry="24" fill="#a0522d" opacity="0.6" />
        <ellipse cx="100" cy="95" rx="9" ry="14" fill="#d4a060" opacity="0.5" />
        <!-- Centre dot -->
        <circle cx="100" cy="100" r="4" fill="#b48232" />
        <!-- Outer ring -->
        <circle cx="100" cy="100" r="90" fill="none" stroke="#b48232" stroke-width="1" opacity="0.4" />
      </svg>

      <p class="splash-title">Henna by Hamna</p>
      <p class="splash-sub">The Craft Book</p>
    </div>

    <slot />

    <!-- Dismiss splash once page is fully loaded -->
    <script is:inline>
      (function () {
        var splash = document.getElementById('splash');
        if (!splash) return;

        // Respect reduced motion: skip splash entirely
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          splash.remove();
          return;
        }

        function dismiss() {
          splash.classList.add('is-hidden');
          setTimeout(function () { splash.remove(); }, 700);
        }

        // Dismiss after page loads (or after 3s max so it never hangs)
        if (document.readyState === 'complete') {
          setTimeout(dismiss, 400);
        } else {
          window.addEventListener('load', function () {
            setTimeout(dismiss, 400);
          });
        }
        setTimeout(dismiss, 3000);
      })();
    </script>
  </body>
</html>
